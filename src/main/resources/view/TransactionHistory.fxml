<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.TransactionHistoryController"
      alignment="CENTER"
      spacing="15">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="TRANSACTION HISTORY"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <TableView fx:id="transactionTable"
               prefWidth="850"
               prefHeight="400">

        <columns>

            <TableColumn fx:id="dateColumn"
                         text="Date"
                         prefWidth="175"/>

            <TableColumn fx:id="typeColumn"
                         text="Transaction Type"
                         prefWidth="140"/>

            <TableColumn fx:id="amountColumn"
                         text="Amount"
                         prefWidth="140"/>

            <TableColumn fx:id="balanceColumn"
                         text="Balance After"
                         prefWidth="140"/>

            <TableColumn fx:id="transactionIDColumn"
                         text="Transaction ID"
                         prefWidth="200"/>

        </columns>
    </TableView>

    <Button text="BACK TO DASHBOARD"
            onAction="#backToDashboard"/>

</VBox>
