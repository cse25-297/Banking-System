<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="18.0" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController">

    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>

    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #123456;" text="BANKING SYSTEM DASHBOARD" />

    <Label fx:id="welcomeLabel"
           text="Welcome!"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label fx:id="totalBalanceLabel"
           text="Total Balance: BWP 0.00"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Button onAction="#viewAccounts" prefWidth="300" text="VIEW ACCOUNTS" />
    <Button onAction="#openNewAccount" prefWidth="300" text="OPEN NEW ACCOUNT" />
    <Button onAction="#depositMoney" prefWidth="300" text="DEPOSIT MONEY" />
    <Button onAction="#withdrawMoney" prefWidth="300" text="WITHDRAW MONEY" />
    <Button onAction="#transactionHistory" prefWidth="300" text="TRANSACTION HISTORY" />

    <Button onAction="#logout" prefWidth="300" style="-fx-background-color: #b83232; -fx-text-fill: white; -fx-font-weight: bold;" text="LOGOUT" />

</VBox>
